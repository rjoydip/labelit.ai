{
  "name": "labelit.ai",
  "version": "0.0.0",
  "bin": {
    "labelit": "./src/cli/index.ts"
  },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./harness": "./src/harness/index.ts",
    "./webhook": "./src/webhook/index.ts",
    "./providers": "./src/providers/github/index.ts",
    "./services": "./src/services/index.ts",
    "./ai": "./src/ai/processor.ts",
    "./utils": "./src/utils/index.ts",
    "./types": "./src/types/index.ts",
    "./config": "./src/config/index.ts",
    "./cli": "./src/cli/index.ts",
    "./cli/client": "./src/cli/client.ts",
    "./cli/server": "./src/cli/server.ts",
    "./cli/types": "./src/cli/types.ts"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "wrangler dev",
    "dev:run": "bun src/index.ts",
    "build": "wrangler build",
    "deploy": "wrangler deploy",
    "cli": "bun run src/cli/index.ts",
    "labelit": "bun run src/cli/index.ts",
    "labelit:start": "bun run src/cli/index.ts start",
    "labelit:stop": "bun run src/cli/index.ts stop",
    "labelit:status": "bun run src/cli/index.ts status",
    "format": "oxfmt . --write",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "webhook": "bun run webhook.ts",
    "knip": "knip --production --exclude files",
    "actions-up": "actions-up",
    "code:quality:dash": "bun run ./scripts/code-quality.ts",
    "lint:ci": "bun run actions-up && bun run format:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.75.4",
    "@earendil-works/pi-ai": "^0.75.4",
    "hono": "^4.12.21"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "4.1.5",
    "actions-up": "^1.14.1",
    "knip": "^5.88.1",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.66.0",
    "simple-git-hooks": "^2.13.1",
    "smee-client": "^3.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  },
  "simple-git-hooks": {
    "pre-commit": "bun install --ignore-scripts --offline && bun run format && bun run lint:ci",
    "pre-push": "bun run build && bun run test"
  },
  "packageManager": "bun@1.3.13"
}
