{
  "name": "@labelit/services",
  "version": "0.0.0",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./feedback": {
      "default": "./src/feedback.ts"
    },
    "./pr-analyzer": {
      "default": "./src/analyzer/pull-request.ts"
    },
    "./ticket-analyzer": {
      "default": "./src/analyzer/ticket.ts"
    }
  },
  "scripts": {
    "lint": "oxlint . --fix",
    "format": "oxfmt . --write",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "update": "bun update"
  },
  "dependencies": {
    "@labelit/ai": "workspace:*"
  },
  "devDependencies": {
    "@labelit/types": "workspace:*",
    "@vitest/coverage-v8": "^3.0.9",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
