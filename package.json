{
  "name": "labelit.ai",
  "version": "0.0.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "turbo run dev",
    "knip": "knip",
    "build": "turbo run build",
    "lint": "oxlint .",
    "format": "oxfmt . --write",
    "format:check": "oxfmt --check .",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "typecheck": "turbo run typecheck",
    "actions-up": "actions-up",
    "webhook": "bun run webhook.ts",
    "code:quality:dash": "bun run ./scripts/code-quality.ts",
    "lint:ci": "bun run actions-up && bun run format:check && bun run lint && bun run typecheck",
    "update": "turbo run update -- --ignore-scripts --no-progress --no-summary"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "actions-up": "^1.14.1",
    "knip": "^5.88.1",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "simple-git-hooks": "^2.13.1",
    "smee-client": "^3.1.1",
    "turbo": "^2.9.6",
    "vitest": "^4.1.5"
  },
  "simple-git-hooks": {
    "pre-commit": "bun install --ignore-scripts --offline && bun run format && bun run lint:ci",
    "pre-push": "bun run build && bun run test"
  },
  "packageManager": "bun@1.1.3"
}
